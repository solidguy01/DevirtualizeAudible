{
  "manifest_version": 3,
  "name": "DevirtualizeAudible",
  "version": "1.1.0",

  "description": "Removes AI-narrated titles (Virtual Voice, AI Voice, voice replica and similar) from Audible listings.",

  "icons": {
    "48": "icons/Devirtualizer.png"
  },

  "action": {
    "default_icon": "icons/Devirtualizer.png",
    "default_popup": "html/Devirtualizer.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.audible.com/*"],
      "js": ["js/devirtualizeAudible.js"]
    }
  ]
}

